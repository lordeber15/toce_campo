# Local: levanta su propio Postgres+PostGIS (perfil db).
COMPOSE_PROFILES=db

# ---- Postgres ----
DB_HOST=localhost
DB_PORT=5433
DB_USER=toce
DB_PASSWORD=toce_dev_password
DB_NAME=toce

# ---- MinIO ----
MINIO_ROOT_USER=toce_minio
MINIO_ROOT_PASSWORD=toce_minio_password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=toce
# URL publica que usara el movil para subir/descargar archivos (presigned URLs).
# En local: la IP de tu Mac en la LAN. En VPS: https://files.tudominio.com
MINIO_PUBLIC_URL=http://localhost:9000

# ---- API ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TZ=America/Lima

# ---- Web ----
VITE_API_URL=http://localhost:4000

# Mapa base (opcional): archivo PMTiles propio. Vacío = última compilación diaria de Protomaps (OSM).
# BASEMAP_PMTILES_URL=


# Puertos locales de MinIO (el teléfono y la API ya los usan). Para el VPS ver .env.vps.example.
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
