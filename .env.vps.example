# Configuración para el VPS (copiar a .env y cambiar TODOS los valores <...>).
# Levantar con:  docker compose up -d --build   (COMPOSE_PROFILES=full: API, web y MinIO; usa la base existente)
#
# Puertos en el host (bloque 4710–4714, libre de conflictos con las demás aplicaciones del VPS):
#   4710 web (panel)       → proxy https://toce.tudominio.com
#   4711 API               → proxy https://api.toce.tudominio.com   (la app móvil apunta aquí)
#   4712 MinIO (archivos)  → proxy https://files.toce.tudominio.com (enlaces de fotos y audios)
#   4713 consola MinIO     → solo 127.0.0.1 (túnel SSH: ssh -L 4713:127.0.0.1:4713 vps)
COMPOSE_PROFILES=full
WEB_HOST_PORT=4710
API_HOST_PORT=4711
MINIO_HOST_PORT=4712
MINIO_CONSOLE_HOST_PORT=4713

# ---- Base de datos: la que ya existe en el VPS (postgres_servicios, puerto 5432) ----
# Necesita PostGIS (ver README, "Usar la base de datos existente"). host.docker.internal = el propio VPS.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=toce
DB_PASSWORD=<contraseña larga>
DB_NAME=toce

# ---- MinIO ----
MINIO_ROOT_USER=toce_minio
MINIO_ROOT_PASSWORD=<contraseña larga>
MINIO_USE_SSL=false
MINIO_BUCKET=toce
MINIO_PUBLIC_URL=https://files.toce.tudominio.com

# ---- API ----
API_PORT=4000
API_PUBLIC_URL=https://api.toce.tudominio.com
JWT_ACCESS_SECRET=<mínimo 32 caracteres aleatorios>
JWT_REFRESH_SECRET=<otros 32 caracteres aleatorios>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TZ=America/Lima

# ---- Web ----
VITE_API_URL=https://api.toce.tudominio.com
